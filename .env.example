# ---------------------------------------------------------------------------
# Leviathan - environment variable placeholders.
#
# Copy to .env for local development. NEVER commit real values.
# Nothing in this file is a secret; it is a manifest of what must be set.
#
# WHERE EACH VALUE GOES IN PRODUCTION
#   GitHub Actions -> Settings -> Secrets and variables -> Actions
#   Supabase       -> Project -> Settings -> Edge Functions -> Secrets
# ---------------------------------------------------------------------------

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# SERVER-ONLY. Bypasses Row Level Security. Never expose to a browser.
SUPABASE_SERVICE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
# Used by the deploy job to push edge functions.
SUPABASE_ACCESS_TOKEN=<SUPABASE_PERSONAL_ACCESS_TOKEN>

# --- Chain RPC endpoints ------------------------------------------------------
ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>
BASE_RPC=https://base-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>
SOL_RPC=https://solana-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>

# --- Pricing ------------------------------------------------------------------
COINGECKO_KEY=<COINGECKO_DEMO_API_KEY>

# --- Telegram -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
ADMIN_TELEGRAM_ID=<YOUR_TELEGRAM_USER_ID>

# --- Scheduled job auth -------------------------------------------------------
# Shared secret the cron caller must present to the edge functions.
CRON_SECRET=<RANDOM_LONG_STRING>

# --- Payments -----------------------------------------------------------------
SOLANA_RECEIVING_WALLET=<SOLANA_WALLET_ADDRESS>
